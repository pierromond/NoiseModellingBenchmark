      "speed": "~15 min",
      "tutorialScript": "benchmark/simulations/getting_started/compare_clisson.groovy",
      "modelScript": "benchmark/simulations/runscriptV6.0.groovy",
      "files": [
        "BUILDINGS.geojson",
        "DEM.geojson",
        "GROUNDS.geojson",
        "LW_ROADS.geojson",
        "RECEIVERS.geojson"
      ],
      "layers": [
        "BUILDINGS.geojson",
        "RECEIVERS.geojson",
        "ROADS.geojson",
        "GROUNDS.geojson"
      ]
    },
    "montagne": {
      "label": "La Montagne",
      "folder": "montagne",
      "dir": "benchmark/input/montagne",
