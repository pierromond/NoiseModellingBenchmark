        "LW_ROADS": "Source height (Set_Height)",
        "RECEIVERS": "Receiver height (Set_Height)"
      },
      "files": [
        "BUILDINGS.geojson",
        "DEM.geojson",
        "GROUNDS.geojson",
        "LW_ROADS.geojson",
        "RECEIVERS.geojson"
      ],
      "layers": [
        "BUILDINGS.geojson",
        "GROUNDS.geojson",
        "LW_ROADS.geojson",
        "RECEIVERS.geojson"
      ]
    }
  },
  "models": {
    "clisson": {
      "exec": {
        "tableBuilding": "BUILDINGS",
        "tableSources": "LW_ROADS",
        "tableReceivers": "RECEIVERS",
        "tableDEM": "DEM",
        "tableGroundAbs": "GROUNDS",
        "confReflOrder": 1,
        "confMaxSrcDist": 300,
        "confDiffHorizontal": true,
        "confMaxError": 0.1,
        "confFavorableOccurrencesDefault": "0.25, 0.25, 0.25, 0.25, 0.25, 0.25, 0.25, 0.25, 0.25, 0.25, 0.25, 0.25, 0.25, 0.25, 0.25, 0.25",
        "confRecordProfile": true
      },
      "setHeight": []
    },
    "montagne": {
      "exec": {
        "tableBuilding": "BUILDINGS",
        "tableSources": "LW_ROADS",
        "tableReceivers": "RECEIVERS",
        "tableDEM": "DEM",
        "tableGroundAbs": "GROUNDS",
        "confRaysName": "RAYS",
        "confReflOrder": 2,
        "confMaxReflDist": 500,
        "confDiffVertical": true,
        "confMaxSrcDist": 10000,
        "confDiffHorizontal": true,
        "confTemperature": 24,
        "confExportSourceId": false,
        "confSkipLevening": true,
        "confSkipLnight": true,
        "confSkipLden": true,
        "confMaxError": 0,
        "confFavorableOccurrencesDefault": "0.5, 0.5, 0.75, 1.0, 0.75, 0.5, 0.5, 0.5, 0.5, 0.5, 0.25, 0.0, 0.25, 0.5, 0.5, 0.5"
