{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "measure_comparison.schema.json",
  "title": "measure_comparison.json",
  "description": "Global comparison of each version to the measured La Montagne levels (all measurement campaigns aggregated, one calibrated offset).",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["version", "offset", "n_measured", "n_compared",
                 "mean_error", "std_error", "rmse", "max_abs_error", "scatter"],
    "properties": {
      "version": {"type": "string"},
      "offset": {"type": "number"},
      "n_measured": {"type": "integer"},
      "n_compared": {"type": "integer"},
      "mean_error": {"type": "number"},
      "std_error": {"type": "number"},
      "rmse": {"type": "number"},
      "max_abs_error": {"type": "number"},
      "scatter": {"type": "array", "items": {"type": "array", "items": {"type": ["number", "string"]}}},
      "receivers": {"type": "array", "items": {"type": "array"}},
      "campaigns": {"type": "array", "items": {"type": "string"}},
      "campaign_labels": {"type": "object"},
      "n_per_campaign": {"type": "object"},
      "references": {"type": "object"},
      "offsets": {"type": "object"}
    },
    "additionalProperties": true
  }
}
