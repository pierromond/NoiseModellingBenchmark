{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rays.schema.json",
  "title": "rays_<campagne>.geojson",
  "description": "Propagation rays (full profile geometry) per measurement campaign, for the explainability section of La Montagne.",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": {"const": "FeatureCollection"},
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "properties", "geometry"],
        "properties": {
          "type": {"const": "Feature"},
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
              "type": {"const": "LineString"},
              "coordinates": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}}
            }
          },
          "properties": {
            "type": "object",
            "required": ["receiver", "campagne", "leq"],
            "properties": {
              "receiver": {"type": ["integer", "string"]},
              "source": {"type": ["integer", "string", "null"]},
              "campagne": {"type": "string"},
              "leq": {"type": ["number", "null"]},
              "meteo": {"type": ["string", "null"]},
              "period": {"type": ["string", "null"]},
              "aDiv": {"type": ["number", "null"]},
              "aAtm": {"type": ["number", "null"]},
              "aDif": {"type": ["number", "null"]},
              "aRef": {"type": ["number", "null"]},
              "aGlobal": {"type": ["number", "null"]},
              "ground": {},
              "groundCoefficients": {"type": "array", "items": {"type": ["number", "null"]}},
              "cutProfile": {"type": "array", "items": {"type": "array", "items": {"type": ["number", "null"]}}},
              "nReflections": {"type": "integer"},
              "nDiffractions": {"type": "integer"},
              "nodes": {"type": "array"}
            },
            "additionalProperties": true
          }
        }
      }
    }
  }
}
