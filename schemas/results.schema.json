{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "results.schema.json",
  "title": "results.json",
  "description": "Aggregated per-version stats consumed by the website.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["version", "mean", "time", "timePerReceive", "nbRays", "timePerRays", "nNan", "silenceThreshold", "histogram"],
    "properties": {
      "version": {"type": "string"},
      "mean": {"type": "number"},
      "time": {"type": "string"},
      "timePerReceive": {"type": "string"},
      "nbRays": {"type": "number"},
      "nbProfiles": {"type": "number"},
      "timePerRays": {"type": "number"},
      "timePerProfiles": {"type": "number"},
      "nNan": {"type": "integer"},
      "silenceThreshold": {"type": "number"},
      "histogram": {"type": "object", "additionalProperties": {"type": "integer"}},
      "java": {"type": "string"},
      "runner": {"type": "string"}
    },
    "additionalProperties": true
  }
}
